# Copy to .env and adjust. Never commit the real .env file.
ENVIRONMENT=development
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./ccp.db
# MySQL:
# DATABASE_URL=mysql+pymysql://ccp:ccp_password@localhost:3306/ccp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

FIRST_ADMIN_NAME=System Administrator
FIRST_ADMIN_EMAIL=admin@ccp-portal.example.com
FIRST_ADMIN_PASSWORD=Admin@12345
